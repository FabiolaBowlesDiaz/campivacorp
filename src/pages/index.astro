---
import Layout from '~/layouts/PageLayout.astro';
import HeroMain from '~/components/widgets/HeroMain.astro';
import StatsCounter from '~/components/widgets/StatsCounter.astro';
import NosotrosSection from '~/components/widgets/NosotrosSection.astro';
import ProductosSection from '~/components/widgets/ProductosSection.astro';
import ServiciosSection from '~/components/widgets/ServiciosSection.astro';
import ValoresSection from '~/components/widgets/ValoresSection.astro';
import CertificacionesSection from '~/components/widgets/CertificacionesSection.astro';
import PropositoSection from '~/components/widgets/PropositoSection.astro';
import IntelligenceSection from '~/components/widgets/IntelligenceSection.astro';
import ContactoSection from '~/components/widgets/ContactoSection.astro';

const metadata = {
  title: 'campivacorp. - Soluciones agroindustriales para el mundo',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero (id="inicio" is inside the component) -->
  <HeroMain />

  <!-- Stats Counter (id="stats" is inside the component) -->
  <StatsCounter />

  <!-- Content Sections -->
  <NosotrosSection />
  <ProductosSection />
  <ServiciosSection />
  <ValoresSection />
  <CertificacionesSection />
  <PropositoSection />

  <!-- Puente con Campiva Intelligence -->
  <IntelligenceSection />

  <!-- Contact Section -->
  <ContactoSection />
</Layout>
