---
/**
 * BrandOrnament.astro - Decorative leaf shape for white-background sections.
 *
 * IMPORTANT: The parent element must have `position: relative` (or Tailwind `relative` class)
 * for the absolute positioning to work correctly.
 *
 * Usage: Only on white-background sections. NOT on dark (#25272f) sections.
 */
export interface Props {
  position?: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right';
  size?: number;
  class?: string;
}

const {
  position = 'top-right',
  size = 400,
  class: className = '',
} = Astro.props;

const positionClasses: Record<string, string> = {
  'top-left': 'top-0 left-0 -translate-x-1/4 -translate-y-1/4',
  'top-right': 'top-0 right-0 translate-x-1/4 -translate-y-1/4',
  'bottom-left': 'bottom-0 left-0 -translate-x-1/4 translate-y-1/4',
  'bottom-right': 'bottom-0 right-0 translate-x-1/4 translate-y-1/4',
};
---

<div
  class:list={[
    'absolute pointer-events-none overflow-hidden opacity-[0.06]',
    positionClasses[position],
    className,
  ]}
  style={`width: ${size}px; height: ${size}px;`}
  aria-hidden="true"
>
  <svg
    viewBox="0 0 200 200"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-full"
  >
    <!-- Large organic leaf shape derived from isotipo central leaf -->
    <path
      d="M100 190 C95 170, 60 130, 45 90 C30 50, 50 10, 100 5 C150 10, 170 50, 155 90 C140 130, 105 170, 100 190Z"
      fill="#95b444"
    />
  </svg>
</div>
