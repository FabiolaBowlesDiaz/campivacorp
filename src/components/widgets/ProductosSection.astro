---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import BrandOrnament from '~/components/ui/BrandOrnament.astro';
import { Icon } from 'astro-icon/components';

const categories = [
  {
    id: 'aceites',
    name: 'Aceites',
    icon: 'tabler:droplet',
    products: ['Crudo de Soya', 'Crudo de Girasol', 'Refinado de Soya', 'Refinado de Girasol', 'Refinado Soya+Girasol Blend'],
  },
  {
    id: 'harinas',
    name: 'Harinas y Tortas',
    icon: 'tabler:grain',
    products: ['Harina de Soya Expeller', 'Torta de Soya Estándar', 'Torta de Soya HiPro', 'Torta de Girasol', 'Harina de Carne y Hueso', 'Harina de Plumas'],
  },
  {
    id: 'granos',
    name: 'Granos',
    icon: 'tabler:plant',
    products: ['Soya', 'Maíz', 'Sorgo', 'Maní', 'Quinua (blanca/negra/roja)', 'Chía', 'Sésamo (negro/blanco)', 'Cacao', 'Café'],
  },
  {
    id: 'endulzantes',
    name: 'Endulzantes',
    icon: 'tabler:candy',
    products: ['Azúcar Refinada', 'Azúcar Rubia', 'Miel de Abeja', 'Stevia'],
  },
  {
    id: 'grasas',
    name: 'Grasas',
    icon: 'tabler:flask',
    products: ['Mantecas y Margarinas', 'Sebo Bovino', 'Ácidos Grasos', 'Oleinas Vegetales', 'Lecitina de Soya'],
  },
  {
    id: 'forestales',
    name: 'Derivados Forestales',
    icon: 'tabler:tree',
    products: ['Carbón Vegetal', 'Leña'],
  },
  {
    id: 'hidrocarburos',
    name: 'Hidrocarburos',
    icon: 'tabler:gas-station',
    products: ['Gasolina', 'Diesel ULSD'],
  },
];
---

<WidgetWrapper id="productos" containerClass="max-w-7xl mx-auto">
  <Fragment slot="bg">
    <div class="absolute inset-0 bg-[#f7f8f2]"></div>
    <BrandOrnament position="bottom-right" size={350} />
  </Fragment>

  <div data-aos="fade-up">
    <Headline title="Productos" subtitle="7 categorías de productos agroindustriales" />
  </div>

  <div class="flex flex-wrap justify-center gap-6">
    {categories.map((cat, index) => (
      <div class="w-full md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]" data-aos="fade-up" data-aos-delay={String(index * 50)}>
        <div class="bg-white rounded-xl border border-[#95b444]/20 shadow-sm hover:shadow-lg transition-shadow h-full p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-11 h-11 rounded-lg bg-[#95b444]/15 flex items-center justify-center flex-shrink-0">
              <Icon name={cat.icon} class="w-6 h-6 text-[#5d6f31]" />
            </div>
            <h3 class="font-heading font-semibold text-xl text-heading">{cat.name}</h3>
          </div>
          <ul class="space-y-1.5 text-muted text-sm leading-relaxed">
            {cat.products.map((p) => (
              <li class="flex gap-2">
                <span class="text-[#95b444] font-bold" aria-hidden="true">·</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</WidgetWrapper>
