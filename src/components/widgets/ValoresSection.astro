---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';

const values = [
  { icon: 'tabler:award', title: 'Calidad', description: 'Comprometidos con los estandares mas altos de calidad e inocuidad en cada producto y proceso.' },
  { icon: 'tabler:heart-handshake', title: 'Respeto', description: 'Respeto por nuestro entorno, medio ambiente, colaboradores y principios eticos que guian cada decision.' },
  { icon: 'tabler:star', title: 'Excelencia', description: 'Somos especialistas y perfeccionistas en cada eslabon de la cadena de valor agroindustrial.' },
  { icon: 'tabler:flame', title: 'Pasion', description: 'Pasion por la agroindustria y la cadena de valor alimentaria que impulsa todo lo que hacemos.' },
];
---

<WidgetWrapper id="valores" containerClass="max-w-7xl">
  <Headline
    title="Valores"
    subtitle="Los principios que nos definen"
  />
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {values.map((value) => (
      <div class="text-center p-6 rounded-lg border-t-4 border-[#95b444]">
        <Icon name={value.icon} class="w-12 h-12 text-[#95b444] mx-auto mb-4" />
        <h3 class="font-heading font-bold text-lg mb-2">{value.title}</h3>
        <p class="text-muted text-sm leading-relaxed">{value.description}</p>
      </div>
    ))}
  </div>
</WidgetWrapper>
