---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';

const services = [
  { icon: 'tabler:arrows-exchange', title: 'Trading', description: 'Comercialización de materias primas y productos agroindustriales en mercados locales e internacionales.' },
  { icon: 'tabler:arrows-exchange-2', title: 'Brokeraje', description: 'Intermediación comercial especializada conectando productores con compradores estratégicos.' },
  { icon: 'tabler:truck', title: 'Logística local e internacional', description: 'Gestión integral de transporte y distribución para garantizar la entrega oportuna de productos.' },
  { icon: 'tabler:chart-line', title: 'Analítica de mercados y Soft Landing', description: 'Inteligencia de mercado y acompañamiento para la entrada exitosa en nuevos mercados regionales.' },
  { icon: 'tabler:bulb', title: 'Asesoramiento técnico y comercial', description: 'Consultoría especializada en procesos agroindustriales y estrategia comercial.' },
  { icon: 'tabler:building-factory', title: 'Maquilas', description: 'Servicios de procesamiento y transformación industrial bajo especificaciones del cliente.' },
  { icon: 'tabler:microscope', title: 'Análisis de laboratorio vía Surveyors', description: 'Control de calidad y certificación de productos mediante laboratorios y surveyors acreditados.' },
];
---

<WidgetWrapper id="servicios" containerClass="max-w-7xl">
  <Fragment slot="bg">
    <div class="absolute inset-0 bg-white"></div>
  </Fragment>
  <div data-aos="fade-up">
    <Headline
      title="Servicios"
      subtitle="Soluciones integrales para la cadena agroindustrial"
    />
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {services.map((service, index) => (
      <div class="bg-white rounded-lg p-6 border border-gray-100 hover:shadow-md transition-shadow duration-300" data-aos="fade-up" data-aos-delay={String(index * 100)}>
        <Icon name={service.icon} class="w-12 h-12 text-[#95b444] mb-4" />
        <h3 class="font-heading font-bold text-lg mb-2">{service.title}</h3>
        <p class="text-muted text-sm leading-relaxed">{service.description}</p>
      </div>
    ))}
  </div>
</WidgetWrapper>
