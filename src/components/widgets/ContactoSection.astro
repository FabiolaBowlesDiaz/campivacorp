---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';
---

<WidgetWrapper id="contacto" containerClass="max-w-7xl mx-auto">
  <div data-aos="fade-up">
    <Headline title="Contactanos" subtitle="Estamos para ayudarte" />
  </div>

  <div class="grid md:grid-cols-2 gap-12">
    <!-- LEFT: Contact form -->
    <div data-aos="fade-up" data-aos-delay="100">
      <!-- Replace YOUR_ID with your Formspree form ID from https://formspree.io -->
      <form action="https://formspree.io/f/YOUR_ID" method="POST" class="space-y-5">
        <input type="hidden" name="_next" value="/#contacto" />
        <input type="hidden" name="_subject" value="Nuevo contacto desde campivacorp.com" />

        <div>
          <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Nombre *</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="py-3 px-4 block w-full rounded-lg border border-gray-200 text-sm focus:border-primary focus:ring-1 focus:ring-primary bg-white"
            placeholder="Tu nombre"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="py-3 px-4 block w-full rounded-lg border border-gray-200 text-sm focus:border-primary focus:ring-1 focus:ring-primary bg-white"
            placeholder="tu@email.com"
          />
        </div>

        <div>
          <label for="company" class="block text-sm font-medium text-gray-700 mb-1">Empresa</label>
          <input
            type="text"
            id="company"
            name="company"
            class="py-3 px-4 block w-full rounded-lg border border-gray-200 text-sm focus:border-primary focus:ring-1 focus:ring-primary bg-white"
            placeholder="Tu empresa"
          />
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Mensaje *</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            class="py-3 px-4 block w-full rounded-lg border border-gray-200 text-sm focus:border-primary focus:ring-1 focus:ring-primary bg-white"
            placeholder="Como podemos ayudarte?"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-3 px-6 rounded-lg bg-primary text-white font-semibold hover:bg-secondary transition-colors"
        >
          Enviar Mensaje
        </button>
      </form>
    </div>

    <!-- RIGHT: Contact info -->
    <div class="flex flex-col justify-center space-y-8" data-aos="fade-up" data-aos-delay="200">
      <div class="flex items-start gap-4">
        <Icon name="tabler:mail" class="w-6 h-6 text-primary flex-shrink-0 mt-1" />
        <div>
          <p class="font-medium text-gray-900">Email</p>
          <a href="mailto:rcampbell@campivacorp.com" class="text-muted hover:text-primary transition-colors">
            rcampbell@campivacorp.com
          </a>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <Icon name="tabler:phone" class="w-6 h-6 text-primary flex-shrink-0 mt-1" />
        <div>
          <p class="font-medium text-gray-900">Telefono</p>
          <a href="tel:+59169006424" class="text-muted hover:text-primary transition-colors">
            +591 69006424
          </a>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <Icon name="tabler:brand-linkedin" class="w-6 h-6 text-primary flex-shrink-0 mt-1" />
        <div>
          <p class="font-medium text-gray-900">LinkedIn</p>
          <a
            href="https://www.linkedin.com/company/campivacorp/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted hover:text-primary transition-colors"
          >
            campivacorp
          </a>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <Icon name="tabler:brand-whatsapp" class="w-6 h-6 text-primary flex-shrink-0 mt-1" />
        <div>
          <p class="font-medium text-gray-900">WhatsApp</p>
          <a
            href="https://wa.me/59169006424"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted hover:text-primary transition-colors"
          >
            +591 69006424
          </a>
        </div>
      </div>
    </div>
  </div>
</WidgetWrapper>
