---
// Logo.astro - campivacorp. logo from brand book
// Uses extracted PNG with transparent background for pixel-perfect fidelity
import logoFull from '~/assets/images/campivacorp-logo-full.png';
import { Image } from 'astro:assets';
---

<span class="flex items-center">
  <Image
    src={logoFull}
    alt="campivacorp."
    class="h-9 w-auto"
    widths={[200, 400]}
    loading="eager"
  />
</span>
